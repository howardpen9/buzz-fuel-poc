# Buzz Fuel adapter — copy to .env and fill in.
# Never commit a real .env.
#
# PUBLIC (community may set)
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_CHANNEL_ID=<channel-uuid>
BUZZ_BOT_AUTH_MODE=standalone
# MAKEREEL_API_URL should be the official HTTPS origin in any shared deploy.
MAKEREEL_API_URL=https://makereel.xyz

# SECRET (unique per adapter process; never share with other communities)
BUZZ_BOT_PRIVATE_KEY=<nsec-or-hex>
# FORBIDDEN for community distribution (platform-only today):
# Do not hand INTERNAL_API_KEY to untrusted installers — see docs/16 audit.
INTERNAL_API_KEY=<platform-or-dev-only>

# OPTIONAL
# BUZZ_BOT_AUTH_MODE=owner-attested
# BUZZ_AUTH_TAG=<nip-oa-tag-json>
# BUZZ_OWNER_PRIVATE_KEY=<only if computing auth tag locally>
# BUZZ_FUEL_POLL_INTERVAL_SECS=5
# BUZZ_FUEL_POLL_TIMEOUT_SECS=900
# BUZZ_FUEL_PUBLISH_RUNNING=false
